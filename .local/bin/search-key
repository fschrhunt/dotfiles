#!/bin/bash
# search-key: save the Exa API key that search uses on fat, then prove Exa accepts it.
# Paste the key at the prompt. Input stays hidden; the last 4 characters are shown so you know
# the paste landed. Exa must accept the key before it is saved. The key travels over ssh's stdin, never the command line, into fat's
# owner-only ~/.config/search/keys.env, which tap's search entry loads.
set -euo pipefail

printf 'Paste your Exa API key, then press Enter: '
IFS= read -rs key
echo
key=$(printf '%s' "$key" | tr -d '[:space:]')
if [ -z "$key" ]; then
  echo "No key entered; nothing changed." >&2
  exit 1
fi
echo "Got a key ending in ...${key: -4} (${#key} characters). Checking it with Exa..."

# Runs on fat with the key on stdin: try one Exa search with it, and only if Exa
# accepts it write it atomically and restart tap so the Macs pick it up.
save='set -eu
IFS= read -r key
if ! EXA_API_KEY=$key "$HOME/.local/bin/search" test exa "rust ownership" >/dev/null 2>&1; then
  echo "Exa refused that key, so nothing changed. Check it and run search-key again." >&2
  exit 1
fi
umask 077
mkdir -p "$HOME/.config/search"
printf "EXA_API_KEY=%s\n" "$key" > "$HOME/.config/search/keys.env.tmp"
mv "$HOME/.config/search/keys.env.tmp" "$HOME/.config/search/keys.env"
systemctl --user restart tap.service
echo "Saved. Exa answered a test search, so agents now search with Exa."'

if [ "$(hostname -s)" = fat ]; then
  printf '%s\n' "$key" | bash -c "$save"
else
  printf '%s\n' "$key" | ssh fat "bash -c $(printf '%q' "$save")"
fi

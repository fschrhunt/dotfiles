#!/usr/bin/env bash
# claude-worktree create|remove|unlock: Claude Code's WorktreeCreate, WorktreeRemove and SessionEnd
# hooks.
#
# create reads {name,cwd,session_id} from stdin and prints the path of
# <repo>/.claude/worktrees/<name> on branch claude/<name>. It reuses an existing worktree and
# migrates an older worktree-<name> branch when it is reopened, then locks the worktree with the
# session id so `worktree clean` keeps a live session. remove deletes that worktree and its
# claude/* branch. unlock releases locks held by an ended session, whether the worktree was kept
# or removed. create delegates to worktree --prepare, so base/fetch/collision rules stay in one
# place.
set -euo pipefail

command=${1:-}
input=$(cat)

require() {
  command -v "$1" >/dev/null 2>&1 || { echo "claude-worktree: $1 is required" >&2; exit 1; }
}
require jq
require git

# lock_reason DIR PATH: print PATH's lock reason in DIR's worktree list, or empty.
lock_reason() {
  local dir=$1 want=$2 line p='' reason=''
  while IFS= read -r line; do
    case $line in
      'worktree '*) p=${line#worktree }; reason= ;;
      'locked '*) reason=${line#locked } ;;
      'locked') reason=locked ;;
      '')
        if [[ $p == "$want" ]]; then
          printf '%s\n' "$reason"
          return 0
        fi
        p=
        reason=
        ;;
    esac
  done < <(git -C "$dir" worktree list --porcelain; printf '\n')
  return 1
}

# main_checkout DIR: the repository's main checkout, or "" outside a repository.
main_checkout() {
  local dir=$1 common
  common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  if [[ $(basename "$common") == .git ]]; then
    dirname "$common"
  else
    git -C "$dir" rev-parse --path-format=absolute --show-toplevel 2>/dev/null
  fi
}

# unlock_session MAIN SESSION: unlock claude worktrees under MAIN locked by SESSION.
unlock_session() {
  local main=$1 sid=$2 line p='' branch='' reason=''
  [[ -n $sid ]] || return 0
  while IFS= read -r line; do
    case $line in
      'worktree '*) p=${line#worktree }; branch=; reason= ;;
      'branch refs/heads/'*) branch=${line#branch refs/heads/} ;;
      'locked '*) reason=${line#locked } ;;
      'locked') reason=locked ;;
      '')
        if [[ $p == "$main"/.claude/worktrees/* && $branch == claude/* &&
          $reason == *"session $sid"* ]]; then
          git -C "$main" worktree unlock "$p" >/dev/null 2>&1 || true
        fi
        p=
        branch=
        reason=
        ;;
    esac
  done < <(git -C "$main" worktree list --porcelain; printf '\n')
}

case $command in
  create)
    name=$(jq -r '.name // empty' <<<"$input")
    cwd=$(jq -r '.cwd // empty' <<<"$input")
    sid=$(jq -r '.session_id // empty' <<<"$input")
    [[ -n $name && -n $cwd ]] || { echo "claude-worktree: create needs name and cwd" >&2; exit 1; }
    cd "$cwd" || exit 1
    main=$(main_checkout "$cwd") || { echo "claude-worktree: $cwd is not in a git repository" >&2; exit 1; }
    dir=$main/.claude/worktrees/$name
    if [[ -d $dir ]]; then
      reason=$(lock_reason "$main" "$dir") || reason=
      if [[ -n $reason ]]; then
        if [[ -n $sid && $reason == *"session $sid"* ]]; then
          git -C "$main" worktree unlock "$dir" >/dev/null 2>&1 || true
        else
          echo "claude-worktree: $dir is locked ($reason); unlock it if stale" >&2
          exit 1
        fi
      fi
    fi
    dir=
    IFS= read -r -d '' dir < <("${WORKTREE:-$HOME/.local/bin/worktree}" --prepare claude -w "$name") || true
    [[ -n $dir ]] || { echo "claude-worktree: could not create worktree $name" >&2; exit 1; }
    # Claude used to name these branches worktree-<name>; rename one in place when it is reopened.
    actual=$(git -C "$dir" branch --show-current 2>/dev/null) || actual=
    if [[ $actual == "worktree-$name" ]]; then
      if git -C "$dir" show-ref -q --verify "refs/heads/claude/$name"; then
        echo "claude-worktree: both worktree-$name and claude/$name exist; keeping $actual" >&2
      else
        git -C "$dir" branch -m "claude/$name" || true
      fi
    fi
    # Claude Code does not git-lock hook-created worktrees; hold one while the session runs so
    # worktree clean keeps it. SessionEnd and WorktreeRemove release it.
    git -C "$dir" worktree lock --reason "claude-worktree session ${sid:-unknown}" "$dir" \
      >/dev/null 2>&1 || true
    printf '%s\n' "$dir"
    ;;
  remove)
    path=$(jq -r '.worktree_path // empty' <<<"$input")
    [[ -n $path ]] || { echo "claude-worktree: remove needs worktree_path" >&2; exit 1; }
    [[ -d $path ]] || exit 0
    top=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null) || exit 0
    [[ $top == "$path" ]] || { echo "claude-worktree: $path is not a worktree root" >&2; exit 1; }
    common=$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 1
    main=$(dirname "$common")
    case $path in
      "$main"/.claude/worktrees/*) ;;
      *) echo "claude-worktree: refusing to remove $path outside $main/.claude/worktrees" >&2; exit 1 ;;
    esac
    branch=$(git -C "$path" branch --show-current 2>/dev/null) || branch=
    case $branch in
      claude/*) ;;
      *) echo "claude-worktree: refusing to remove branch '${branch:-detached HEAD}'" >&2; exit 1 ;;
    esac
    git -C "$main" worktree unlock "$path" >/dev/null 2>&1 || true
    git -C "$main" worktree remove --force "$path"
    git -C "$main" branch -D "$branch" >/dev/null 2>&1 || true
    ;;
  unlock)
    cwd=$(jq -r '.cwd // empty' <<<"$input")
    sid=$(jq -r '.session_id // empty' <<<"$input")
    [[ -n $cwd && -d $cwd ]] || cwd=${CLAUDE_PROJECT_DIR:-$PWD}
    main=$(main_checkout "$cwd" 2>/dev/null) ||
      main=$(main_checkout "${CLAUDE_PROJECT_DIR:-$PWD}" 2>/dev/null) ||
      exit 0
    unlock_session "$main" "$sid"
    ;;
  *)
    echo "usage: claude-worktree create|remove|unlock" >&2
    exit 2
    ;;
esac
